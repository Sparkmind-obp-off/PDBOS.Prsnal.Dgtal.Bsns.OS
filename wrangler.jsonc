{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdbos",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",

  // D1 — real relational database for PDBOS.
  // Production database is created with: npx wrangler d1 create pdbos-production
  // Local dev uses an automatic local SQLite mirror via the --local flag.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pdbos-production",
      "database_id": "1d5e97b1-6f69-4a2b-a13e-1f9b28d2986f"
    }
  ]
}
