{
  "name": "pdbos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --d1=pdbos-production --local --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "wrangler pages dev dist --d1=pdbos-production --local",
    "deploy": "npm run build && wrangler pages deploy dist",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl -s http://localhost:3000/api/health",
    "db:migrate:local": "wrangler d1 migrations apply pdbos-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply pdbos-production",
    "db:seed": "wrangler d1 execute pdbos-production --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed",
    "db:console:local": "wrangler d1 execute pdbos-production --local",
    "db:console:prod": "wrangler d1 execute pdbos-production",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250705.0",
    "@hono/vite-cloudflare-pages": "^0.4.2",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "wrangler": "^3.90.0"
  }
}
